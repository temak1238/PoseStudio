<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Sicherung und Geräteumzug (ab Android 12): nur die Einstellungen, keine Bilder. -->
<data-extraction-rules>
	<cloud-backup>
		<include domain="file" path="settings.json" />
	</cloud-backup>
	<device-transfer>
		<include domain="file" path="settings.json" />
	</device-transfer>
</data-extraction-rules>
