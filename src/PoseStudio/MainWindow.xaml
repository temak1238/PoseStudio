<Window x:Class="PoseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pose Studio" Width="1520" Height="920" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" Icon="Assets/PoseStudio.ico">

    <Window.Resources>
        <!-- Zeile: Beschriftung, Regler, Zahlenfeld -->
        <DataTemplate x:Key="AxisTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                        VerticalAlignment="Center" SmallChange="1" LargeChange="10" />
                <TextBox Grid.Column="2" Style="{StaticResource ValueBox}"
                         Text="{Binding Value, StringFormat=F0, UpdateSourceTrigger=LostFocus}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <Button Content="Beenden" Padding="14,1" Click="Exit_Click" ToolTip="Einstellungen speichern und Pose Studio beenden" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- ============ Links: Pose ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Figuren in der Szene">
                        <StackPanel>
                            <ListBox x:Name="FigureList" MaxHeight="110" SelectionChanged="FigureList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" Background="{Binding Swatch}" BorderBrush="#555" BorderThickness="1" Margin="0,0,6,0"
                                                    ToolTip="Farbe im ControlNet-Bild" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <UniformGrid Columns="3" Margin="0,2,0,0">
                                <Button Content="+ Neu" Click="AddFigure_Click" ToolTip="Neue Figur neben die anderen stellen" />
                                <Button Content="Duplizieren" Click="DuplicateFigure_Click" ToolTip="Aktive Figur mit Pose kopieren" />
                                <Button Content="Entfernen" Click="RemoveFigure_Click" />
                            </UniformGrid>
                            <CheckBox x:Name="ClickSelectsFigureCheck" Content="Figur per Klick in der Ansicht wählen" Margin="0,4,0,0" FontSize="11"
                                      ToolTip="Aus: In der Ansicht lässt sich nur die in der Liste markierte Figur anklicken und bewegen – andere Figuren sind gesperrt." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Figur">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <CheckBox x:Name="HairCheck" DockPanel.Dock="Right" Content="Haare" VerticalAlignment="Center" Margin="8,0,0,0"
                                          Checked="Figure_Changed" Unchecked="Figure_Changed" />
                                <ComboBox x:Name="FigureStyleCombo" SelectionChanged="FigureStyle_Changed" />
                            </DockPanel>
                            <Expander x:Name="ProportionExpander" Header="Proportionen" Margin="0,4,0,0">
                                <StackPanel>
                                    <ItemsControl x:Name="ProportionItems" ItemTemplate="{StaticResource AxisTemplate}" />
                                    <Button Content="Proportionen zurücksetzen" HorizontalAlignment="Left" Click="ResetProportions_Click" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Pose-Vorlagen">
                        <StackPanel>
                            <ComboBox x:Name="PresetCombo" Margin="2" MaxDropDownHeight="520" SelectionChanged="PresetCombo_SelectionChanged">
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2B7BD6" Margin="4,6,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                            <UniformGrid Columns="2">
                                <Button Content="Anwenden" Click="ApplyPreset_Click" />
                                <Button Content="Bibliothek…" Click="OpenLibrary_Click" ToolTip="Alle Vorlagen mit Vorschaubild, eigene Vorlagen" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Referenzfoto (aktive Figur)">
                        <StackPanel>
                            <UniformGrid Columns="3">
                                <Button Content="Foto laden…" Click="PickRefImage_Click" ToolTip="Foto halbtransparent über die Ansicht legen – nur für die aktive Figur, wird nie exportiert" />
                                <Button Content="Pose übernehmen" Click="PoseFromPhoto_Click" FontWeight="SemiBold" ToolTip="Pose der Person im Foto erkennen und auf die aktive Figur übertragen" />
                                <Button Content="Entfernen" Click="RemoveRefImage_Click" />
                            </UniformGrid>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Deckkraft" Width="60" VerticalAlignment="Center" />
                                <Slider x:Name="RefOpacitySlider" Minimum="10" Maximum="90" Value="50" VerticalAlignment="Center" ValueChanged="RefOpacity_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="RefImageText" Margin="0,2,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap"
                                       Text="Kein Foto. Jede Figur kann ihr eigenes Referenzfoto haben." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Objekt in der Hand">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Objekt" Width="60" VerticalAlignment="Center" />
                                <ComboBox x:Name="PropCombo" SelectionChanged="PropType_Changed" />
                            </DockPanel>
                            <StackPanel x:Name="PropPanel">
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Halten" Width="60" VerticalAlignment="Center" />
                                    <ComboBox x:Name="HoldCombo" SelectionChanged="Hold_Changed" />
                                </DockPanel>
                                <Expander Header="Lage des Objekts" IsExpanded="False" Margin="0,2,0,0">
                                    <ItemsControl x:Name="PropItems" ItemTemplate="{StaticResource AxisTemplate}"
                                                  PreviewMouseLeftButtonDown="UndoPoint_PreviewMouseDown" />
                                </Expander>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Left" Content="Grundposition" Click="PropDefault_Click" />
                                    <TextBlock x:Name="PropStatus" VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#B04000" />
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                           Text="Die Arme folgen dem Objekt. In der Ansicht: Objekt anklicken, Strg + ziehen = verschieben, Umschalt + ziehen = drehen." />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Hände und Finger">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Links" Width="60" VerticalAlignment="Center" />
                                <ComboBox x:Name="GestureLeftCombo" SelectionChanged="Gesture_Changed" MaxDropDownHeight="420" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Rechts" Width="60" VerticalAlignment="Center" />
                                <ComboBox x:Name="GestureRightCombo" SelectionChanged="Gesture_Changed" MaxDropDownHeight="420" />
                            </DockPanel>
                            <Expander x:Name="FingerExpander" Header="Finger einzeln" Margin="0,2,0,0">
                                <StackPanel>
                                    <UniformGrid Columns="2" Margin="0,2">
                                        <RadioButton x:Name="FingerLeftRadio" Content="Linke Hand" IsChecked="True" Checked="FingerHand_Changed" />
                                        <RadioButton Content="Rechte Hand" Checked="FingerHand_Changed" />
                                    </UniformGrid>
                                    <ItemsControl x:Name="FingerItems" ItemTemplate="{StaticResource AxisTemplate}"
                                                  PreviewMouseLeftButtonDown="UndoPoint_PreviewMouseDown" />
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="HandStatus" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                       Text="Einzelne Fingerglieder: Finger in der Ansicht anklicken. Hält eine Hand ein Objekt, formt der Griff die Finger." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Gelenke">
                        <ListBox x:Name="JointList" Height="250" DisplayMemberPath="DisplayName"
                                 SelectionChanged="JointList_SelectionChanged" />
                    </GroupBox>

                    <GroupBox x:Name="AxisGroup" Header="Ausgewähltes Gelenk">
                        <StackPanel>
                            <TextBlock x:Name="SelectedJointText" FontWeight="SemiBold" Margin="0,0,0,4" Text="– Gelenk anklicken –" />
                            <ItemsControl x:Name="AxisItems" ItemTemplate="{StaticResource AxisTemplate}"
                                          PreviewMouseLeftButtonDown="UndoPoint_PreviewMouseDown" />
                            <Button Content="Gelenk zurücksetzen" HorizontalAlignment="Left" Click="ResetJoint_Click" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Position der Figur">
                        <StackPanel PreviewMouseLeftButtonDown="UndoPoint_PreviewMouseDown">
                            <ItemsControl x:Name="PositionItems" ItemTemplate="{StaticResource AxisTemplate}" />
                            <CheckBox x:Name="AutoGroundCheck" Content="Automatisch auf den Boden stellen" IsChecked="True"
                                      Margin="0,4" Checked="AutoGround_Changed" Unchecked="AutoGround_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Pose">
                        <WrapPanel>
                            <Button Content="Spiegeln" Click="Mirror_Click" ToolTip="Links und rechts tauschen" />
                            <Button Content="Rückgängig" Click="Undo_Click" ToolTip="Strg+Z" />
                            <Button Content="Alles zurücksetzen" Click="ResetAll_Click" />
                            <Button Content="Pose speichern…" Click="SavePose_Click" />
                            <Button Content="Pose laden…" Click="LoadPose_Click" />
                            <Button Content="Als Vorlage speichern…" Click="SaveTemplate_Click" ToolTip="Pose der aktiven Figur in die eigene Bibliothek (mit Vorschaubild)" />
                        </WrapPanel>
                    </GroupBox>

                    <TextBlock Margin="10,6" TextWrapping="Wrap" Foreground="#666" FontSize="11">
                        <Run FontWeight="SemiBold">Bedienung in der Ansicht</Run><LineBreak />
                        Klick auf Körperteil: Gelenk auswählen<LineBreak />
                        Linke Maustaste ziehen: Kamera drehen<LineBreak />
                        Rechte Maustaste ziehen: Kamera verschieben<LineBreak />
                        Mausrad: Entfernung<LineBreak />
                        Strg + ziehen: Gelenk beugen / seitlich<LineBreak />
                        Umschalt + ziehen: Gelenk drehen<LineBreak />
                        Strg + ziehen am Becken: Figur auf dem Boden verschieben<LineBreak />
                        Umschalt + ziehen am Becken: Figur drehen<LineBreak />
                        Alt + ziehen: Licht bewegen
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Mitte: 3D-Ansicht ============ -->
            <Grid x:Name="PreviewHost" Grid.Column="1" Background="#2D2D30" SizeChanged="PreviewHost_SizeChanged" ClipToBounds="True">
                <Border x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6E6E6"
                        BorderBrush="#111" BorderThickness="1"
                        MouseLeftButtonDown="Frame_MouseLeftButtonDown" MouseLeftButtonUp="Frame_MouseLeftButtonUp"
                        MouseRightButtonDown="Frame_MouseRightButtonDown" MouseRightButtonUp="Frame_MouseRightButtonUp"
                        MouseMove="Frame_MouseMove" MouseWheel="Frame_MouseWheel">
                    <Grid ClipToBounds="True">
                        <Image x:Name="BgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Viewport3D x:Name="View" ClipToBounds="True">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="ViewCamera" />
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="SceneVisual" />
                        </Viewport3D>
                        <Image x:Name="RefImage" Stretch="Uniform" IsHitTestVisible="False" Opacity="0.5" />
                        <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <TextBlock x:Name="FrameInfo" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                           Foreground="#BBB" FontSize="11" />
                <Button x:Name="RemoveRefOverlayButton" Content="Referenzbild entfernen ✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" Padding="10,4" Visibility="Collapsed" Click="RemoveRefImage_Click"
                        ToolTip="Referenzbild und erkanntes Skelett ausblenden (das Bild wird nie exportiert)" />
            </Grid>

            <!-- ============ Rechts: Kamera & Ausgabe ============ -->
            <DockPanel Grid.Column="2">
            <!-- Export-Buttons immer sichtbar, auch auf kleinen Bildschirmen -->
            <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,6">
                <Button DockPanel.Dock="Right" Content="Ordner öffnen" Click="OpenFolder_Click" Margin="6,0,0,0" />
                <Button x:Name="ExportButton" Content="JPG exportieren" FontSize="15" FontWeight="SemiBold" Padding="10,8"
                        Background="#2B7BD6" Foreground="White" Click="Export_Click" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Kamera">
                        <StackPanel>
                            <ItemsControl x:Name="CameraItems" ItemTemplate="{StaticResource AxisTemplate}" />
                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <Button Content="Vorne" Click="CamPreset_Click" Tag="0" />
                                <Button Content="3/4" Click="CamPreset_Click" Tag="35" />
                                <Button Content="Seite" Click="CamPreset_Click" Tag="90" />
                                <Button Content="Hinten" Click="CamPreset_Click" Tag="180" />
                                <Button Content="Oben" Click="CamTop_Click" />
                                <Button Content="Unten" Click="CamLow_Click" />
                                <Button Content="Ganz" Click="CamFull_Click" ToolTip="Ganze Figur einpassen" />
                                <Button Content="Porträt" Click="CamPortrait_Click" ToolTip="Kopf und Oberkörper" />
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Ausgabe">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Vorschau-Format" Width="100" VerticalAlignment="Center" />
                                <ComboBox x:Name="PreviewFormatCombo" SelectionChanged="PreviewFormat_Changed" />
                            </DockPanel>
                            <CheckBox x:Name="GuidesCheck" Content="Hilfslinien für die anderen Exportformate" Margin="0,4,0,0"
                                      IsChecked="True" Checked="Guides_Changed" Unchecked="Guides_Changed" />
                            <TextBlock Text="Exportieren – Seitenverhältnis (lange Seite unten):" Margin="0,6,0,2" FontWeight="SemiBold" />
                            <ItemsControl x:Name="ExportFormatList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Format.Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Exportieren – KI-Auflösungen (SDXL, feste Pixel):" Margin="0,6,0,2" FontWeight="SemiBold" />
                            <ItemsControl x:Name="FixedFormatList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Format.Name}" IsChecked="{Binding IsChecked}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,6,0,2">
                                <TextBlock Text="Lange Seite (px)" Width="100" VerticalAlignment="Center" />
                                <ComboBox x:Name="LongSideCombo" IsEditable="True" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Benutzerdef. (px)" Width="100" VerticalAlignment="Center" />
                                <TextBox x:Name="CustomWBox" Width="60" />
                                <TextBlock Text=" × " VerticalAlignment="Center" />
                                <TextBox x:Name="CustomHBox" Width="60" HorizontalAlignment="Left" LostFocus="CustomSize_LostFocus" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,2">
                                <TextBlock Text="Dateiformat" Width="100" VerticalAlignment="Center" />
                                <RadioButton x:Name="JpgRadio" Content="JPG" GroupName="FileType" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FileType_Changed" />
                                <RadioButton x:Name="PngRadio" Content="PNG" GroupName="FileType" VerticalAlignment="Center" Checked="FileType_Changed" />
                            </DockPanel>
                            <TextBlock Text="Zusätzlich für ComfyUI (PNG, gleicher Ausschnitt):" Margin="0,6,0,2" FontWeight="SemiBold" />
                            <CheckBox x:Name="Cn3dCheck" Content="ControlNet 3D-Pose (anima__3dpose)" Margin="0,1"
                                      ToolTip="Figuren einfarbig glänzend auf Schwarz, jede Figur eigene Farbe – ohne Kulisse, Haare und Objekte" />
                            <CheckBox x:Name="CnRegionCheck" Content="Regionen-Karte (anima__regional)" Margin="0,1"
                                      ToolTip="Flache Farbfläche je Figur auf Schwarz – für eigene Prompts je Person" />
                            <CheckBox x:Name="CnOnlyCheck" Content="Nur diese Bilder (ohne normales Bild)" Margin="0,1,0,4" />
                            <CheckBox x:Name="TransparentCheck" Margin="100,2,0,2" Checked="FileType_Changed" Unchecked="FileType_Changed"
                                      ToolTip="Nur wenn kein Hintergrundbild gesetzt ist. Schatten bleiben halbtransparent erhalten.">
                                <TextBlock Text="Transparenter Hintergrund (PNG, ohne Hintergrundbild)" TextWrapping="Wrap" />
                            </CheckBox>
                            <DockPanel x:Name="QualityRow" Margin="0,2">
                                <TextBlock Text="JPG-Qualität" Width="100" VerticalAlignment="Center" />
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource ValueBox}"
                                         Text="{Binding Value, ElementName=QualitySlider, StringFormat=F0}" />
                                <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" Value="95" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,2">
                                <TextBlock Text="Zielordner" Width="100" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="…" Click="BrowseFolder_Click" />
                                <TextBox x:Name="FolderBox" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Dateiname" Width="100" VerticalAlignment="Center" />
                                <TextBox x:Name="PrefixBox" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Kulisse (3D-Hintergrund)">
                        <StackPanel>
                            <ComboBox x:Name="SetCombo" SelectionChanged="SetType_Changed" />
                            <DockPanel x:Name="SetColorRow" Margin="0,4,0,0">
                                <TextBlock x:Name="SetColorLabel" Text="Farbe" Width="90" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Wählen…" Click="PickSetColor_Click" />
                                <Border x:Name="SetSwatch" Width="22" Height="22" BorderBrush="#555" BorderThickness="1" DockPanel.Dock="Right" Margin="4,0" />
                                <TextBlock />
                            </DockPanel>
                            <WrapPanel x:Name="SetColorPresetPanel" Margin="90,2,0,2" Visibility="{Binding Visibility, ElementName=SetColorRow}" />
                            <DockPanel x:Name="SetFloorRow" Margin="0,4,0,0">
                                <TextBlock Text="Boden" Width="90" VerticalAlignment="Center" />
                                <ComboBox x:Name="SetFloorCombo" SelectionChanged="SetFloor_Changed" />
                            </DockPanel>
                            <ItemsControl x:Name="SetItems" ItemTemplate="{StaticResource AxisTemplate}" Margin="0,4,0,0" />
                            <CheckBox x:Name="HorizonCheck" Content="Horizontlinie (Augenhöhe der Kamera) zeigen" Margin="0,4,0,0"
                                      Checked="Horizon_Changed" Unchecked="Horizon_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Licht &amp; Schatten">
                        <StackPanel>
                            <ItemsControl x:Name="LightItems" ItemTemplate="{StaticResource AxisTemplate}" />
                            <UniformGrid Columns="4" Margin="0,4,0,2">
                                <Button Content="Vorne" Click="LightPreset_Click" Tag="20,45" ToolTip="Licht von vorne-seitlich" />
                                <Button Content="Seite" Click="LightPreset_Click" Tag="90,30" ToolTip="Seitenlicht" />
                                <Button Content="Gegenlicht" Click="LightPreset_Click" Tag="180,35" ToolTip="Licht von hinten" />
                                <Button Content="Mittag" Click="LightPreset_Click" Tag="30,80" ToolTip="Licht von oben" />
                            </UniformGrid>
                            <CheckBox x:Name="CastShadowCheck" Content="Schattenwurf (sonst nur weicher Bodenschatten)" Margin="0,2"
                                      Checked="Light_Changed" Unchecked="Light_Changed" />
                            <CheckBox x:Name="LightFollowCheck" Content="Licht dreht mit der Kamera mit" Margin="0,2"
                                      Checked="Light_Changed" Unchecked="Light_Changed" />
                            <CheckBox x:Name="ShowLightCheck" Content="Lichtquelle in der Vorschau zeigen (Alt + ziehen)" Margin="0,2"
                                      Checked="Light_Changed" Unchecked="Light_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Darstellung">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Hintergrund" Width="90" VerticalAlignment="Center" />
                                <Button x:Name="BgPickButton" DockPanel.Dock="Right" Content="Wählen…" Click="PickBackground_Click" />
                                <Border x:Name="BgSwatch" Width="22" Height="22" BorderBrush="#555" BorderThickness="1" DockPanel.Dock="Right" Margin="4,0" />
                                <TextBox x:Name="BgHexBox" VerticalAlignment="Center" LostFocus="BgHexBox_LostFocus" KeyDown="HexBox_KeyDown" />
                            </DockPanel>
                            <WrapPanel x:Name="BgPresetPanel" Margin="90,2,0,4" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Figurfarbe" Width="90" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Wählen…" Click="PickBody_Click" />
                                <Border x:Name="BodySwatch" Width="22" Height="22" BorderBrush="#555" BorderThickness="1" DockPanel.Dock="Right" Margin="4,0" />
                                <TextBox x:Name="BodyHexBox" VerticalAlignment="Center" LostFocus="BodyHexBox_LostFocus" KeyDown="HexBox_KeyDown" />
                            </DockPanel>
                            <WrapPanel x:Name="BodyPresetPanel" Margin="90,2,0,4" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Haarfarbe" Width="90" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Wählen…" Click="PickHair_Click" />
                                <Border x:Name="HairSwatch" Width="22" Height="22" BorderBrush="#555" BorderThickness="1" DockPanel.Dock="Right" Margin="4,0" />
                                <TextBlock />
                            </DockPanel>
                            <WrapPanel x:Name="HairPresetPanel" Margin="90,2,0,4" />
                            <DockPanel Margin="0,8,0,2">
                                <TextBlock Text="Hintergrundbild" Width="90" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Entfernen" Click="RemoveBgImage_Click" />
                                <Button DockPanel.Dock="Right" Content="Bild…" Click="PickBgImage_Click" />
                                <ComboBox x:Name="BgStretchCombo" SelectionChanged="BgStretch_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="BgImageText" Margin="90,0,0,4" Foreground="#666" FontSize="11" TextTrimming="CharacterEllipsis" Text="(kein Bild)" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Column="1" Text="Vorschau" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Export" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Boden + Raster" />
                                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="FloorPreviewCheck" Checked="Display_Changed" Unchecked="Display_Changed" />
