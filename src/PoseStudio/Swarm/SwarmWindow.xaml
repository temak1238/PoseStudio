<Window x:Class="PoseStudio.Swarm.SwarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pose Studio – SwarmUI" Width="1500" Height="950" MinWidth="900" MinHeight="600"
        Background="{DynamicResource WindowBg}" FontSize="12">
    <Window.Resources>
        <DataTemplate x:Key="ThumbTemplate">
            <Border Width="124" Margin="3" Padding="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ToolTip="{Binding ToolTip}">
                <StackPanel>
                    <Border Height="120" Background="{DynamicResource TileBg}">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="10.5" MaxHeight="28" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Width" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Einstellungen ================= -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,3" Foreground="{DynamicResource StatusText}" />
                <DockPanel>
                    <Button x:Name="ClearQueueButton" DockPanel.Dock="Right" Content="Leeren" Margin="6,0,0,0" Padding="10,6" Click="ClearQueue_Click" Visibility="Collapsed" ToolTip="Wartende Aufträge verwerfen (der laufende läuft weiter)" />
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Abbrechen" Margin="6,0,0,0" Padding="10,6" Click="Cancel_Click" IsEnabled="False" ToolTip="Laufenden Auftrag abbrechen (wartende bleiben in der Warteschlange)" />
                    <Button x:Name="GenerateButton" Content="Generieren" FontSize="15" FontWeight="SemiBold" Padding="10,8"
                            Background="#2B7BD6" Foreground="White" Click="Generate_Click" />
                </DockPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <GroupBox Header="Server">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Verbinden" Margin="6,0,0,0" Click="Connect_Click" />
                                <TextBox x:Name="UrlBox" />
                            </DockPanel>
                            <TextBlock x:Name="ServerText" Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Einstellungen">
                        <StackPanel>
                            <Expander x:Name="HistoryExpander" Header="Aus einem SwarmUI-Bild übernehmen" Expanded="HistoryExpander_Expanded">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,2"
                                               Text="Klick auf ein Bild übernimmt dessen Modell, LoRAs, Prompts, Sampler und alle weiteren Einstellungen (z. B. FaceRefine). Init Image, Größe und Seed kommen von hier; Refiner-Werte werden zur Vorgabe für „Nachbessern“." />
                                    <CheckBox x:Name="PromptsOnlyCheck" Content="Nur Prompts übernehmen (Prompt und Negativ-Prompt, alles andere bleibt)" Margin="0,2,0,4" />
                                    <ListBox x:Name="HistoryList" Height="300" ItemTemplate="{StaticResource ThumbTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistoryList_SelectionChanged" />
                                    <Button Content="Liste aktualisieren" HorizontalAlignment="Left" Margin="0,3" Click="RefreshHistory_Click" />
                                </StackPanel>
                            </Expander>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Löschen" Margin="4,0,0,0" Click="DeleteProfile_Click" />
                                <Button DockPanel.Dock="Right" Content="Speichern…" Margin="4,0,0,0" Click="SaveProfile_Click" />
                                <TextBlock Text="Profil" Style="{StaticResource Lbl}" Width="50" />
                                <ComboBox x:Name="ProfileCombo" SelectionChanged="Profile_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="BaseText" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Modell">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="56" Height="56" Background="{DynamicResource TileBg}" Margin="0,0,6,0">
                                    <Image x:Name="ModelImage" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ModelText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ToggleButton x:Name="ModelPickToggle" Content="Modell wählen…" HorizontalAlignment="Left" Margin="0,3,0,0" Click="ModelPick_Click" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="ModelPicker" Visibility="Collapsed" Margin="0,4,0,0">
                                <DockPanel>
                                    <ComboBox x:Name="ModelFolderCombo" DockPanel.Dock="Right" Width="170" Margin="4,0,0,0" SelectionChanged="ModelSearch_Changed" ToolTip="Nur Modelle aus diesem Ordner zeigen" />
                                    <TextBox x:Name="ModelSearch" TextChanged="ModelSearch_Changed" ToolTip="Suchen" />
                                </DockPanel>
                                <ListBox x:Name="ModelList" Height="320" ItemTemplate="{StaticResource ThumbTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ModelList_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="LoRAs">
                        <StackPanel>
                            <ItemsControl x:Name="LoraSelected">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="X" Width="22" FontWeight="Bold" Margin="4,0,0,0" Click="RemoveLora_Click" Tag="{Binding}" ToolTip="Entfernen" />
                                            <TextBox DockPanel.Dock="Right" Width="44" Text="{Binding Weight, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" ToolTip="Gewicht" />
                                            <Slider DockPanel.Dock="Right" Width="90" Minimum="-1" Maximum="2" SmallChange="0.05" LargeChange="0.1" Value="{Binding Weight}" Margin="4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox x:Name="AutoTriggerCheck" Content="Trigger-Wörter der LoRAs automatisch in den Prompt" Margin="0,3" />
                            <ToggleButton x:Name="LoraPickToggle" Content="LoRA hinzufügen…" HorizontalAlignment="Left" Click="LoraPick_Click" />
                            <StackPanel x:Name="LoraPicker" Visibility="Collapsed" Margin="0,4,0,0">
                                <DockPanel>
                                    <ComboBox x:Name="LoraFolderCombo" DockPanel.Dock="Right" Width="170" Margin="4,0,0,0" SelectionChanged="LoraFilter_Changed" />
                                    <TextBox x:Name="LoraSearch" TextChanged="LoraFilter_Changed" ToolTip="Suchen" />
                                </DockPanel>
                                <ListBox x:Name="LoraList" Height="360" ItemTemplate="{StaticResource ThumbTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LoraList_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Prompt">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right" Content="✕" Margin="4,0,0,0" Padding="6,0" Click="CharacterClear_Click" ToolTip="Charakter leeren" />
                                <Button DockPanel.Dock="Right" Content="Charakter …" Width="104" Margin="4,0,0,0" Click="AnimaDexChars_Click" ToolTip="Charakter aus AnimaDex suchen – ersetzt den Charakter" />
                                <TextBlock Text="Charakter" Width="62" VerticalAlignment="Center" />
                                <TextBox x:Name="CharacterBox" TextWrapping="Wrap" VerticalContentAlignment="Center"
                                         ToolTip="Steht beim Senden vor dem Prompt. Refiner mit Haken „Charakter“ bekommen Name, Serie und die Kopf-Tags (Haare, Augen …)." />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,3">
                                <Button DockPanel.Dock="Right" Content="✕" Margin="4,0,0,0" Padding="6,0" Click="StyleClear_Click" ToolTip="Stil leeren" />
                                <Button DockPanel.Dock="Right" Content="Künstler / Stil …" Width="104" Margin="4,0,0,0" Click="AnimaDexArtists_Click" ToolTip="Künstler-Tag („@name“) aus AnimaDex suchen – ersetzt den Stil" />
                                <TextBlock Text="Stil" Width="62" VerticalAlignment="Center" />
                                <TextBox x:Name="StyleBox" TextWrapping="Wrap" VerticalContentAlignment="Center" ToolTip="Künstler/Stil, steht beim Senden nach dem Charakter und vor dem Prompt." />
                            </DockPanel>
                            <TextBlock Text="Prompt (Szene, Pose, Kleidung …)" Margin="0,2,0,1" />
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="Negativ-Prompt" Margin="0,4,0,1" />
                            <TextBox x:Name="NegativeBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="SegmentGroup" Header="Refiner (Gesicht, Hände …)">
                        <StackPanel>
                            <StackPanel x:Name="SegmentRows" />
                            <DockPanel Margin="0,3,0,0">
                                <Button x:Name="SegmentDeleteButton" DockPanel.Dock="Right" Content="Vorlage löschen" Margin="4,0,0,0" Click="SegmentDelete_Click" Visibility="Collapsed"
                                        ToolTip="Ausgewählte eigene Vorlage aus der Liste entfernen" />
                                <Button DockPanel.Dock="Right" Content="+ Hinzufügen" Margin="4,0,0,0" Click="SegmentAdd_Click" />
                                <ComboBox x:Name="SegmentAddCombo" SelectionChanged="SegmentAddCombo_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="SegmentHint" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource MutedText}"
                                       Text="Jeder Refiner sucht seinen Bereich im fertigen Bild (YOLO-Modell oder Textbeschreibung) und malt ihn mit eigenem Prompt neu. Wird beim Senden als &lt;segment:…&gt; ans Ende des Prompts gehängt." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Init Image (aktuelle Szene)">
                        <StackPanel>
                            <CheckBox x:Name="InitCheck" Content="Szene als Init Image mitschicken" Margin="0,0,0,3" ToolTip="Aus: nur Prompt (und ControlNet, falls aktiv) – die Pose kommt dann allein über ControlNet, Stil und Kleidung sind frei." />
                            <StackPanel x:Name="InitDetails">
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Darstellung" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="LookCombo" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Creativity" Style="{StaticResource Lbl}" />
                                <TextBlock DockPanel.Dock="Right" Width="36" Text="{Binding Value, ElementName=CreativitySlider, StringFormat=0.00}" TextAlignment="Right" />
                                <Slider x:Name="CreativitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                            </DockPanel>
                            <DockPanel Margin="0,1" ToolTip="Legt buntes Zufallsrauschen über Hintergrundfarbe bzw. -bild (nicht über Figuren und 3D-Boden). SwarmUI erfindet dort dann mehr eigenen Hintergrund statt der glatten Fläche. 0 = aus.">
                                <TextBlock Text="Rauschen (Hgr.)" Style="{StaticResource Lbl}" />
                                <TextBlock DockPanel.Dock="Right" Width="36" Text="{Binding Value, ElementName=NoiseSlider, StringFormat=0.00}" TextAlignment="Right" />
                                <Slider x:Name="NoiseSlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                            </DockPanel>
                            </StackPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Seitenlänge" Style="{StaticResource Lbl}" />
                                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Width="110" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <ComboBox x:Name="SideCombo" IsEditable="True" SelectionChanged="Side_Changed" LostFocus="Side_Changed" />
                            </DockPanel>
                            <TextBlock Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2"
                                       Text="Seitenverhältnis und Bildausschnitt kommen aus der Vorschau im Hauptfenster." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Generierung">
                        <StackPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Anzahl" Style="{StaticResource Lbl}" />
                                <TextBox x:Name="CountBox" Width="50" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Seed" Style="{StaticResource Lbl}" />
                                <Button DockPanel.Dock="Right" Content="Zufall" Margin="4,0,0,0" Click="RandomSeed_Click" ToolTip="Seed -1 = jedes Mal neu" />
                                <TextBox x:Name="SeedBox" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Steps / CFG" Style="{StaticResource Lbl}" />
                                <TextBox x:Name="StepsBox" Width="50" ToolTip="0 = aus übernommenen Einstellungen bzw. Standard" />
                                <TextBox x:Name="CfgBox" Width="50" Margin="6,0,0,0" HorizontalAlignment="Left" ToolTip="0 = aus übernommenen Einstellungen bzw. Standard" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Sampler" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="SamplerCombo" IsEditable="True" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Scheduler" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="SchedulerCombo" IsEditable="True" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="VAE" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="VaeCombo" IsEditable="True" ToolTip="None = die im Modell enthaltene VAE (richtig für Illustrious/SDXL), leer = SwarmUI-Standard. Wird je Modellfamilie (Anima, SDXL/Illustrious …) gemerkt." />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <Expander Header="ControlNet (optional)" Margin="0,4">
                        <StackPanel Margin="6,2">
                            <CheckBox x:Name="CnCheck" Content="ControlNet mitschicken" />
                            <StackPanel x:Name="CnDetails">
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Bild" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="CnKindCombo" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Modell" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="CnModelCombo" IsEditable="True" ToolTip="Nur ControlNets, die zur Familie des gewählten Modells passen. Die Wahl wird je Familie gemerkt." />
                            </DockPanel>
                            <TextBlock x:Name="CnFamilyText" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap" Margin="0,2" Visibility="Collapsed" />
                            <StackPanel x:Name="CnImagePanel" Visibility="Collapsed" Margin="0,2">
                                <TextBlock x:Name="CnImageText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Button Content="Bild wählen…" Click="CnPickImage_Click" Padding="6,1" />
                                    <Button Content="Referenzfoto nehmen" Click="CnUseReference_Click" Padding="6,1" Margin="4,0,0,0" />
                                    <Button Content="Szene nehmen" Click="CnUseScene_Click" Padding="6,1" Margin="4,0,0,0" ToolTip="Die Figuren aus Pose Studio als Steuerbild – der Preprocessor macht daraus Tiefe, Linien oder ein Skelett" />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="„Bild: …“-Arten: SwarmUI macht aus dem Bild zuerst ein Steuerbild (Linien, Skizze, Tiefenkarte oder Skelett) und hält sich an dessen Aufbau. Ohne Foto nimmt Pose Studio die Szene. Anima: anima-lllite-any-test-like-v2 (Linien/Skizze), anima-lllite-depth-1 (Tiefe). Illustrious/SDXL: noob-depth (am zuverlässigsten für die Pose), noob-lineart-anime, noob-scribble-pidinet, noob-openpose. Ohne Init Image gilt das Seitenverhältnis des Steuerbilds." />
                            </StackPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Stärke / Start / Ende" Style="{StaticResource Lbl}" Width="120" />
                                <TextBox x:Name="CnStrengthBox" Width="44" />
                                <TextBox x:Name="CnStartBox" Width="44" Margin="4,0,0,0" />
                                <TextBox x:Name="CnEndBox" Width="44" Margin="4,0,0,0" HorizontalAlignment="Left" />
                            </DockPanel>
                            <TextBlock Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                       Text="anima_3dpose: Bild „3D-Pose“, Stärke um 1. Pose Studio schaltet den Preprocessor von SwarmUI ab (sonst würde das Posenbild in ein OpenPose-Skelett umgewandelt). Mit ControlNet kann Creativity höher sein (z. B. 0.8–1.0)." />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Nachbessern (Refiner)" Margin="0,4">
                        <StackPanel Margin="6,2">
                            <TextBlock Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,3"
                                       Text="Gilt für „Nachbessern“ an einem Ergebnis: dasselbe Bild (gleicher Seed) noch einmal mit Refiner-Durchgang und Hochskalierung." />
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Refiner-Anteil" Style="{StaticResource Lbl}" />
                                <TextBox x:Name="RefControlBox" Width="50" HorizontalAlignment="Left" ToolTip="0.1 = 10 %" />
                            </DockPanel>
                            <CheckBox x:Name="RefKeepBgCheck" Content="Hintergrund unscharf lassen (nur die Figur nachbessern)" Margin="0,2,0,2"
                                      ToolTip="Das Bild wird nur hochskaliert und nicht neu gemalt – Tiefenschärfe und Bokeh bleiben erhalten. Danach malt ein Bereichs-Refiner nur die Person neu (Refiner-Anteil = Kreativität). Scharfe Hintergründe bleiben scharf, bekommen aber keine zusätzlichen Details." />
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Hochskalieren ×" Style="{StaticResource Lbl}" />
                                <TextBox x:Name="RefUpscaleBox" Width="50" HorizontalAlignment="Left" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Upscaler" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="RefUpscaleMethodCombo" IsEditable="True" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Methode" Style="{StaticResource Lbl}" />
                                <ComboBox x:Name="RefMethodCombo" IsEditable="True" />
                            </DockPanel>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="Steps / CFG" Style="{StaticResource Lbl}" />
                                <TextBox x:Name="RefStepsBox" Width="50" />
                                <TextBox x:Name="RefCfgBox" Width="50" Margin="6,0,0,0" HorizontalAlignment="Left" />
                            </DockPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource TileBg2}" />

        <!-- ================= Ergebnisse ================= -->
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Liste leeren" Click="ClearResults_Click" />
                <TextBlock Text="Ergebnisse" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource ResultBg}">
                <ItemsControl x:Name="ResultList" Margin="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource ListBg}">
                                <StackPanel Width="300">
                                    <Border Height="300" Background="{DynamicResource TileBg}" Cursor="Hand" MouseLeftButtonUp="ResultImage_Click" Tag="{Binding}">
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource StatusText}" TextWrapping="Wrap" Margin="0,3" />
                                    <WrapPanel IsEnabled="{Binding Done}">
                                        <Button Content="Nachbessern" Margin="0,0,4,2" Click="Refine_Click" Tag="{Binding}" ToolTip="Gleiches Bild mit Refiner und Hochskalierung" />
                                        <Button Content="Seed übernehmen" Margin="0,0,4,2" Click="UseSeed_Click" Tag="{Binding}" />
                                        <Button Content="{Binding StarText}" IsEnabled="{Binding CanStar}" Margin="0,0,4,2" Click="Star_Click" Tag="{Binding}" Foreground="{DynamicResource GoldText}" ToolTip="Stern in SwarmUI setzen/entfernen – SwarmUI legt das Bild dann zusätzlich unter „Starred“ ab" />
                                        <Button Content="Als Referenzbild" Margin="0,0,4,2" Click="UseAsReference_Click" Tag="{Binding}" ToolTip="Im Hauptfenster als Referenzfoto der aktiven Figur einblenden" />
                                        <Button Content="Ordner" Margin="0,0,4,2" Click="OpenFile_Click" Tag="{Binding}" ToolTip="Lokale Kopie im Explorer zeigen" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
