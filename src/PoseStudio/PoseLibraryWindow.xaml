<Window x:Class="PoseStudio.PoseLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posen-Bibliothek" Width="560" Height="720" MinWidth="380" MinHeight="400"
        WindowStartupLocation="Manual" Background="{DynamicResource WindowBg}" ShowInTaskbar="False" Icon="Assets/PoseStudio.ico">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,6">
            <DockPanel>
                <TextBlock Text="Kategorie" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CategoryCombo" Width="140" SelectionChanged="Filter_Changed" />
                <TextBlock Text="Suchen" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox x:Name="SearchBox" VerticalAlignment="Center" TextChanged="Filter_Changed" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Aktuelle Pose speichern…" Click="Save_Click" Margin="6,0,0,0" />
                <Button x:Name="ApplyButton" Content="Ausgewählte Pose anwenden" Click="Apply_Click" IsEnabled="False" FontWeight="SemiBold"
                        ToolTip="Ausgewählte Pose auf die aktive Figur anwenden, Bibliothek bleibt offen" />
            </DockPanel>
        </StackPanel>        <TextBlock DockPanel.Dock="Bottom" Margin="8,2,8,8" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap"
                   Text="Doppelklick übernimmt die Pose für die aktive Figur und schließt die Bibliothek. „Anwenden“ übernimmt die ausgewählte Pose und lässt die Bibliothek offen. Rückgängig mit Strg+Z im Hauptfenster. Eigene Vorlagen: Rechtsklick → Löschen." />
        <ListBox x:Name="Tiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ResultBg}" Margin="8,0,8,0"
                 MouseDoubleClick="Tiles_MouseDoubleClick" SelectionChanged="Tiles_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="158" Margin="3" Padding="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource ListBg}" ToolTip="{Binding Name}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Löschen" Click="Delete_Click" IsEnabled="{Binding IsUser}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Grid Width="150" Height="190" Background="{DynamicResource PanelBg2}">
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FaintText}" />
                                <Image Source="{Binding Image}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource SubtleText}" FontSize="10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
