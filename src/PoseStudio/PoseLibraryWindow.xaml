<Window x:Class="PoseStudio.PoseLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posen-Bibliothek" Width="980" Height="720" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#F3F3F3" ShowInTaskbar="False" Icon="Assets/PoseStudio.ico">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <Button DockPanel.Dock="Right" Content="Aktuelle Pose als Vorlage speichern…" Click="Save_Click" />
            <TextBlock Text="Kategorie" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="CategoryCombo" Width="160" SelectionChanged="Filter_Changed" />
            <TextBlock Text="Suchen" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox x:Name="SearchBox" Width="180" VerticalAlignment="Center" TextChanged="Filter_Changed" />
            <TextBlock />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="8,2,8,8" Foreground="#666" FontSize="11" TextWrapping="Wrap"
                   Text="Klick auf ein Bild wendet die Pose auf die aktive Figur an (Rückgängig mit Strg+Z im Hauptfenster). Eigene Vorlagen: Rechtsklick → Löschen." />
        <ListBox x:Name="Tiles" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="White" Margin="8,0,8,0"
                 PreviewMouseLeftButtonUp="Tiles_PreviewMouseLeftButtonUp">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="158" Margin="3" Padding="4" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" ToolTip="{Binding Name}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Löschen" Click="Delete_Click" IsEnabled="{Binding IsUser}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Grid Width="150" Height="190" Background="#ECECEC">
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA" />
                                <Image Source="{Binding Image}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Category}" Foreground="#888" FontSize="10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
